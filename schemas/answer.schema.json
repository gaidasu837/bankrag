{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceBoundAnswer",
  "type": "object",
  "required": ["answer", "claims", "status"],
  "properties": {
    "answer": {"type": "string"},
    "status": {"enum": ["supported", "insufficient_evidence", "conflicting_evidence", "stale_evidence"]},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "evidence"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "inference": {"type": "boolean", "default": false},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["document_id", "chunk_id", "quote", "source_url", "retrieved_at"],
              "properties": {
                "document_id": {"type": "string"},
                "chunk_id": {"type": "string"},
                "quote": {"type": "string", "minLength": 1},
                "source_url": {"type": "string", "format": "uri"},
                "published_at": {"type": ["string", "null"]},
                "retrieved_at": {"type": "string"},
                "relation": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
