{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceDocument",
  "type": "object",
  "required": ["document_id", "title", "source_url", "official_domain", "retrieved_at", "content_hash", "text"],
  "properties": {
    "document_id": {"type": "string"},
    "title": {"type": "string"},
    "source_url": {"type": "string", "format": "uri"},
    "official_domain": {"type": "string"},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "effective_from": {"type": ["string", "null"], "format": "date"},
    "effective_to": {"type": ["string", "null"], "format": "date"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "text": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
